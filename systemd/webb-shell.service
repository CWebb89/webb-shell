# Rendered by install.sh into ~/.config/systemd/user/webb-shell.service, which
# fills in the quickshell binary and the path to this checkout. This copy is the
# source of truth so the launch path is versioned instead of a hand-written file
# in $HOME.
#
# Restart=on-failure is the reason this unit exists. The shell used to be a bare
# nohup from the compositor's autostart, so one transient runtime error took the
# bar and every panel down until someone started it again by hand.
#
# Started by graphical-session.target, and also by the compositor's autostart
# through ~/.local/bin/webb-shell, which delegates to `systemctl --user start`.
# Both routes drive this same unit, so neither can produce a second instance.
[Unit]
Description=webb-shell (Quickshell for Hyprland)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# The shell inherits this unit's environment, not an interactive shell's, and the
# menu's `when` guards ask `command -v` about tools that live in user
# directories. Without ~/.pi/agent/bin the Ask pi rows evaluate false and vanish
# with no message anywhere — the guard is not wrong, the PATH was. %h keeps the
# line machine-neutral.
Environment=PATH=%h/.local/bin:%h/.pi/agent/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@QS@ -p @REPO@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
