{
  // webb-shell menu definition.
  // Dotted ids define the tree: "system.session.lock" sits under
  // "system.session", which sits under "system".
  // Kind is inferred: "action" -> runs the command detached,
  // "open"/"toggle" -> hands off to an existing shell popup,
  // otherwise -> submenu.
  //
  // Sections, in open order: Apps, Panels, System, Settings, Software,
  // Services, Capture, Reference. A row belongs under Panels if it raises a
  // shell surface; everything that configures the shell belongs under
  // Settings; package management never belongs under System.
  //
  // Fields:
  //   icon        Nerd Font glyph as \uXXXX escape
  //   label       Visible row title (defaults to id)
  //   description Subtitle shown in rows; also searched
  //   aliases     Extra search terms / IPC routes
  //   action      Shell command run detached on select
  //   open        Set Popups.<name>Open = true (hand-off)
  //   toggle      Flip Popups.<name>Open (or bar visibility)
  //   when/disabled/checked  Bash guard expressions
  //
  // Icons are \uXXXX escapes so this file stays plain ASCII.
  // Browse glyphs with any Nerd Font cheat sheet and swap the escapes.

  // Apps — dynamic. MenuPopup.qml injects every installed app from
  // DesktopEntries (real icon, app name + genericName) as a provider row on
  // each open, so new installs appear automatically. The web-app rows below
  // coexist with the generated list.
  "apps": {"icon":"\uf00a","label":"Apps","description":"Launch applications","aliases":["applications"],"provider":"apps"},
    "apps.pi": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/pi.svg","label":"Pi","description":"Coding agent (new session)","when":"command -v pi >/dev/null","action":"kitty -e bash -lc 'cd $HOME && pi'"},
    "apps.herdr": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/herdr.svg","label":"Herdr","description":"Agent workspace supervisor","when":"command -v herdr >/dev/null","action":"kitty -e herdr"},
    "apps.claude": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/claude.svg","label":"Claude","description":"claude.ai","action":"chromium --app=https://claude.ai"},
    "apps.chatgpt": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/chatgpt.svg","label":"ChatGPT","description":"chatgpt.com","action":"chromium --app=https://chatgpt.com"},
    "apps.youtube": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/youtube.svg","label":"YouTube","description":"youtube.com","action":"chromium --app=https://youtube.com"},
    "apps.instagram": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/instagram.svg","label":"Instagram","description":"instagram.com","action":"chromium --app=https://instagram.com"},
    "apps.facebook": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/facebook.svg","label":"Facebook","description":"facebook.com","action":"chromium --app=https://facebook.com"},
    "apps.github": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/github.svg","label":"GitHub","description":"github.com","action":"chromium --app=https://github.com"},
    "apps.gmail": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/gmail.svg","label":"Gmail","description":"mail.google.com","action":"chromium --app=https://mail.google.com"},
    "apps.outlook": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/outlook.svg","label":"Outlook","description":"outlook.live.com","action":"chromium --app=https://outlook.live.com"},
    "apps.makerworld": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/makerworld.svg","label":"MakerWorld","description":"makerworld.com","action":"chromium --app=https://makerworld.com"},
    "apps.printables": {"icon":"","iconUrl":"file://@shellDir@/assets/apps/printables.svg","label":"Printables","description":"printables.com","action":"chromium --app=https://printables.com"},

  // Panels — one row per shell surface. These hand off to windows the
  // shell already has; none of them rebuilds UI inside the menu.
  "panels": {"icon":"\uf009","label":"Panels","description":"Every shell popup, one row each","aliases":["popups","panels"]},
    "panels.glance": {"icon":"\uf06e","label":"Glance","open":"glance","description":"Calendar and weather panel"},
    "panels.clock": {"icon":"\uf017","label":"OSD Clock","toggle":"clock","description":"Toggle the corner clock"},
    "panels.notifs": {"icon":"\uf0f3","label":"Notification Center","open":"notif","description":"Persistent history — read and dismiss entries one at a time","aliases":["notifications","notif history","inbox"]},
    "panels.find": {"icon":"\uf002","label":"Find Files","open":"find","description":"Search files, folders and paths (fd)","aliases":["search","files"]},
    "panels.notes": {"icon":"\uf0f2","label":"Notes","description":"Scratch notes and snippets","aliases":["scratch","snippets","memo","todo"]},
      "panels.notes.open": {"icon":"\uf0f2","label":"Open Notes","open":"notes","description":"Add, edit, copy and delete notes; Enter adds, Esc closes"},
    "panels.media": {"icon":"\uf001","label":"Media Player","description":"Art, transport, seek and player selection — lives in the Audio panel","action":"qs -p @shellDir@ ipc call audio toggle"},
    "panels.agents": {"icon":"\uf080","label":"Agent Usage","description":"Spend and tokens from the local session logs","action":"qs -p @shellDir@ ipc call usage toggle"},
    "panels.phone": {"icon":"\uf10b","label":"Phone","description":"KDE Connect: battery, signal, files, ring, SMS","when":"command -v kdeconnect-cli >/dev/null","aliases":["kdeconnect","android","mobile"]},
      "panels.phone.open": {"icon":"\uf10b","label":"Phone Panel","description":"Device, battery, signal, media, files, clipboard and SMS","when":"command -v kdeconnect-cli >/dev/null","action":"qs -p @shellDir@ ipc call phone toggle"},
      "panels.phone.ring": {"icon":"\uf095","label":"Ring Phone","description":"Make the phone ring to find it","when":"command -v kdeconnect-cli >/dev/null","action":"qs -p @shellDir@ ipc call phone ring"},
    "panels.wifi": {"icon":"\uDB81\uDDDC","label":"Wi-Fi","description":"networks, status, power","open":"wifi","aliases":["wifi"]},
    "panels.bluetooth": {"icon":"\uf294","label":"Bluetooth","description":"devices, scan, radio","open":"bt","aliases":["bluetooth"]},
    "panels.audio": {"icon":"\uf001","label":"Audio","description":"volume, devices, streams","open":"audio","aliases":["audio"]},
    "panels.usb": {"icon":"\uf287","label":"USB Drives","description":"View and eject attached USB drives"},
      "panels.usb.show": {"icon":"\uf287","label":"Show USB Drives","description":"Details, usage and safe eject for each drive","action":"qs -p @shellDir@ ipc call usb toggle"},
      "panels.usb.refresh": {"icon":"\uf021","label":"Rescan USB Drives","action":"qs -p @shellDir@ ipc call usb refresh"},
    "panels.history": {"icon":"\uf120","label":"History","description":"Clipboard, command and notification history"},
      "panels.history.clip": {"icon":"\uf0ea","label":"Clipboard History","description":"Pick a past copy to paste","action":"@shellDir@/bin/clipboard.sh"},
      "panels.history.cmd": {"icon":"\uf120","label":"Command History","description":"Pick a past terminal command","action":"@shellDir@/bin/history.sh"},
      "panels.history.notifs": {"icon":"\uf1da","label":"Notification History","description":"Replay the last notifications as toasts","action":"qs -p @shellDir@ ipc call notify history"},

  // System — session, window actions, updates, hardware and housekeeping.
  "system": {"icon":"\uf013","label":"System","description":"Session, hardware and housekeeping"},
    "system.session": {"icon":"\uf2f1","label":"Session","description":"Lock, logout, reboot, shutdown and reloads"},
      "system.session.lock": {"icon":"\uf023","label":"Lock","action":"qs -p @shellDir@ ipc call lock engage","confirm":true},
      "system.session.logout": {"icon":"\uf08b","label":"Logout","action":"hyprctl dispatch 'hl.dsp.exit()'","confirm":true},
      "system.session.reboot": {"icon":"\uf021","label":"Reboot","action":"systemctl reboot","confirm":true},
      "system.session.shutdown": {"icon":"\uf011","label":"Shutdown","action":"systemctl poweroff","confirm":true},
      "system.session.suspend": {"icon":"\uf186","label":"Suspend","description":"Sleep the machine","action":"systemctl suspend"},
      "system.session.hyprland": {"icon":"\uf021","label":"Reload Hyprland","description":"Re-read the Hyprland config","action":"hyprctl reload"},
      "system.session.shell": {"icon":"\uf21d","label":"Reload Shell","description":"Restart webb-shell","action":"hyprctl dispatch 'hl.dsp.exec_cmd(\"@shellDir@/bin/restart.sh\")'"},
    "system.windows": {"icon":"\uf2d0","label":"Windows","description":"Active window controls"},
      "system.windows.float": {"icon":"\uf077","label":"Toggle Float","action":"hyprctl dispatch 'hl.dsp.window.float({action=\"toggle\"})'"},
      "system.windows.fullscreen": {"icon":"\uf065","label":"Toggle Fullscreen","action":"hyprctl dispatch 'hl.dsp.window.fullscreen({mode=\"fullscreen\", action=\"toggle\"})'"},
      "system.windows.close": {"icon":"\uf00d","label":"Close Window","action":"hyprctl dispatch 'hl.dsp.window.close()'"},
      "system.windows.layout": {"icon":"\uf0db","label":"Toggle Layout","description":"master / dwindle","action":"@shellDir@/bin/layout-toggle.sh"},
      "system.windows.gaps": {"icon":"\uf07e","label":"Toggle Gaps","description":"hide / show window gaps","action":"@shellDir@/bin/gaps-toggle.sh"},
    "system.update": {"icon":"\uf021","label":"Update","description":"System updates and restarts"},
      "system.update.sys": {"icon":"\uf019","label":"System Update · pacman -Syu","action":"kitty --hold -e bash -lc 'sudo pacman -Syu'"},
      "system.update.audio": {"icon":"\uf001","label":"Restart Audio","description":"pipewire + wireplumber","action":"systemctl --user restart pipewire pipewire-pulse wireplumber"},
      "system.update.wifi": {"icon":"\uDB81\uDDDC","label":"Restart Wi-Fi","description":"NetworkManager + iwd","action":"systemctl restart NetworkManager iwd"},
      "system.update.bt": {"icon":"\uf294","label":"Restart Bluetooth","description":"bluetoothd","action":"systemctl restart bluetooth"},
    "system.power": {"icon":"\uf0e7","label":"Power Profile","description":"performance / balanced / saver"},
      "system.power.perf": {"icon":"\uf067","label":"Performance","action":"powerprofilesctl set performance"},
      "system.power.bal": {"icon":"\uf021","label":"Balanced","action":"powerprofilesctl set balanced"},
      "system.power.saver": {"icon":"\uf064","label":"Power Saver","action":"powerprofilesctl set power-saver"},
    "system.account": {"icon":"\uf084","label":"Account","description":"Password and credentials"},
      "system.account.passwd": {"icon":"\uf084","label":"Change Password","description":"passwd — current Linux account","action":"kitty --hold -e passwd"},
    "system.idle": {"icon":"\uf186","label":"Idle","description":"Dim, then turn the display off and lock","aliases":["idle","sleep","dim","blank","away"]},
      "system.idle.stayawake": {"icon":"\uf185","label":"Stay Awake","description":"Hold off the dim, display-off and idle lock","checked":"[[ \"$(jq -r '.stayAwake // false' \"$HOME/.local/state/webb-shell/idle.json\" 2>/dev/null)\" == \"true\" ]]","action":"qs -p @shellDir@ ipc call idle toggle"},
      "system.idle.locknow": {"icon":"\uf023","label":"Lock Now","description":"Lock the screen immediately","action":"qs -p @shellDir@ ipc call lock engage"},
    "system.dnd": {"icon":"\uf0f3","label":"Do Not Disturb","description":"Silence toasts into notification history","checked":"[[ \"$(jq -r '.dnd // false' \"$HOME/.local/state/webb-shell/notifications.json\" 2>/dev/null)\" == \"true\" ]]","action":"qs -p @shellDir@ ipc call notify toggle"},
    "system.reminders": {"icon":"\uf017","label":"Reminders","description":"Set, list and clear desktop reminders"},
      "system.reminders.set": {"icon":"\uf017","label":"Set Reminder","description":"Remind me in N minutes","open":"reminder"},
      "system.reminders.show": {"icon":"\uf06e","label":"Show Reminders","description":"List active reminders","action":"qs -p @shellDir@ ipc call reminder list"},
      "system.reminders.clear": {"icon":"\uf00d","label":"Clear Reminders","description":"Forget all active reminders","action":"qs -p @shellDir@ ipc call reminder clear"},
    "system.crash": {"icon":"\uf188","label":"Diagnose Last Crash","description":"Hand the most recent coredump to the agent","action":"hyprctl dispatch 'hl.dsp.exec_cmd(\"@shellDir@/bin/crash-diagnose.sh\")'"},

  // Settings — everything that changes shell or desktop configuration.
  "settings": {"icon":"\uf1de","label":"Settings","description":"Theme, defaults, bar, agents and config files","aliases":["preferences"]},
    "settings.theme": {"icon":"\uf1fc","label":"Theme","description":"matugen color scheme and mode"},
      "settings.theme.scheme": {"icon":"\uf53f","label":"Scheme & Mode","description":"Pick a matugen palette variant, or edit every colour under Custom","open":"scheme","aliases":["colors","palette","matugen"]},
      "settings.theme.solidwall": {"icon":"\uf0c8","label":"Solid Color Wallpaper","description":"No wallpaper \u2014 the Theme picker's Seed colour, Custom palette, or the themed flat colour","checked":"[[ ! -s \"$HOME/.local/state/webb-shell/background\" ]]","action":"printf '' > \"$HOME/.local/state/webb-shell/background\""},
    "settings.defaults": {"icon":"\uf2bb","label":"Default Apps","description":"Set default applications"},
      "settings.defaults.web": {"icon":"\uf0ac","label":"Web Browser","description":"Choose your default browser"},
        "settings.defaults.web.firefox": {"icon":"\uf269","label":"Firefox","when":"command -v firefox >/dev/null","checked":"[[ \"$(xdg-settings get default-web-browser 2>/dev/null)\" == \"firefox.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set web firefox.desktop && hyprctl reload"},
        "settings.defaults.web.chromium": {"icon":"\uf1b6","label":"Chromium","when":"command -v chromium >/dev/null","checked":"[[ \"$(xdg-settings get default-web-browser 2>/dev/null)\" == \"chromium.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set web chromium.desktop && hyprctl reload"},
        "settings.defaults.web.brave": {"icon":"\uf268","label":"Brave","when":"command -v brave >/dev/null","checked":"[[ \"$(xdg-settings get default-web-browser 2>/dev/null)\" == \"brave-browser.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set web brave-browser.desktop && hyprctl reload"},
        "settings.defaults.web.vivaldi": {"icon":"\uf267","label":"Vivaldi","when":"command -v vivaldi >/dev/null","checked":"[[ \"$(xdg-settings get default-web-browser 2>/dev/null)\" == \"vivaldi.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set web vivaldi.desktop && hyprctl reload"},
      "settings.defaults.term": {"icon":"\uf120","label":"Terminal","description":"Choose your default terminal emulator"},
        "settings.defaults.term.kitty": {"icon":"\uf120","label":"Kitty","when":"command -v kitty >/dev/null","checked":"[[ \"$(gio mime x-scheme-handler/terminal 2>/dev/null | head -2 | awk '{print $NF}' | grep -F '.desktop' | head -1)\" == \"kitty.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set term kitty.desktop && hyprctl reload"},
      "settings.defaults.files": {"icon":"\uf07c","label":"File Manager","description":"Choose your default file manager"},
        "settings.defaults.files.thunar": {"icon":"\uf07c","label":"Thunar","when":"command -v thunar >/dev/null","checked":"[[ \"$(gio mime inode/directory 2>/dev/null | head -2 | awk '{print $NF}' | grep -F '.desktop' | head -1)\" == \"thunar.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set file thunar.desktop && hyprctl reload"},
    "settings.bar": {"icon":"\uf412","label":"Bar","description":"Modules, order, popup placement and tray visibility"},
      "settings.bar.visibility": {"icon":"\uf412","label":"Toggle Bar","toggle":"bar","description":"Show or hide the top bar strip"},
      "settings.bar.panel": {"icon":"\uf013","label":"Bar Settings","open":"barSettings","aliases":["bar","modules","layout","anchor"],"description":"Add, remove, reorder and re-anchor bar modules in one panel"},
      "settings.bar.modules": {"icon":"\uf0c9","label":"Modules","description":"Tick to put a module in the bar, untick to take it out"},
        "settings.bar.modules.workspaces": {"icon":"\uf009","label":"Workspaces","aliases":["bar"],"checked":"bar_in workspaces","action":"@shellDir@/bin/bar-config.sh toggle workspaces left"},
        "settings.bar.modules.recording": {"icon":"\uf03d","label":"Recording","aliases":["bar"],"checked":"bar_in recording","action":"@shellDir@/bin/bar-config.sh toggle recording right"},
        "settings.bar.modules.tray": {"icon":"\uf00a","label":"System Tray","aliases":["bar","tray"],"checked":"bar_in tray","action":"@shellDir@/bin/bar-config.sh toggle tray right"},
        "settings.bar.modules.media": {"icon":"\uf001","label":"Media","aliases":["bar"],"checked":"bar_in media","action":"@shellDir@/bin/bar-config.sh toggle media center"},
        "settings.bar.modules.find": {"icon":"\uf002","label":"Search","aliases":["bar"],"checked":"bar_in find","action":"@shellDir@/bin/bar-config.sh toggle find right"},
        "settings.bar.modules.notes": {"icon":"\uf0f2","label":"Notes","aliases":["bar"],"checked":"bar_in notes","action":"@shellDir@/bin/bar-config.sh toggle notes right"},
        "settings.bar.modules.audio": {"icon":"\uf028","label":"Audio","aliases":["bar"],"checked":"bar_in audio","action":"@shellDir@/bin/bar-config.sh toggle audio right"},
        "settings.bar.modules.wifi": {"icon":"\uf1eb","label":"Wi-Fi","aliases":["bar"],"checked":"bar_in wifi","action":"@shellDir@/bin/bar-config.sh toggle wifi right"},
        "settings.bar.modules.bluetooth": {"icon":"\uf294","label":"Bluetooth","aliases":["bar"],"checked":"bar_in bluetooth","action":"@shellDir@/bin/bar-config.sh toggle bluetooth right"},
        "settings.bar.modules.system": {"icon":"\udb80\ude10","label":"System Monitor","aliases":["bar"],"checked":"bar_in system","action":"@shellDir@/bin/bar-config.sh toggle system right"},
        "settings.bar.modules.usb": {"icon":"\uf287","label":"USB Storage","aliases":["bar"],"checked":"bar_in usb","action":"@shellDir@/bin/bar-config.sh toggle usb right"},
        "settings.bar.modules.agents": {"icon":"\uf080","label":"Agent Usage","aliases":["bar"],"checked":"bar_in agents","action":"@shellDir@/bin/bar-config.sh toggle agents right"},
        "settings.bar.modules.phone": {"icon":"\uf10b","label":"Phone","description":"KDE Connect device status","aliases":["bar"],"checked":"bar_in phone","action":"@shellDir@/bin/bar-config.sh toggle phone right"},
        "settings.bar.modules.battery": {"icon":"\uf240","label":"Battery","aliases":["bar"],"checked":"bar_in battery","action":"@shellDir@/bin/bar-config.sh toggle battery right"},
        "settings.bar.modules.clock": {"icon":"\uf017","label":"Clock","aliases":["bar"],"checked":"bar_in clock","action":"@shellDir@/bin/bar-config.sh toggle clock center"},
        "settings.bar.modules.glance": {"icon":"\uf06e","label":"Glance","aliases":["bar"],"checked":"bar_in glance","action":"@shellDir@/bin/bar-config.sh toggle glance right"},
        "settings.bar.modules.notif": {"icon":"\uf0f3","label":"Notifications","aliases":["bar"],"checked":"bar_in notif","action":"@shellDir@/bin/bar-config.sh toggle notif right"},
        "settings.bar.modules.wallpaper": {"icon":"\uf03e","label":"Wallpaper","aliases":["bar"],"checked":"bar_in wallpaper","action":"@shellDir@/bin/bar-config.sh toggle wallpaper right"},
        "settings.bar.modules.scheme": {"icon":"\uf53f","label":"Theme Scheme","aliases":["bar"],"checked":"bar_in scheme","action":"@shellDir@/bin/bar-config.sh toggle scheme right"},
        "settings.bar.modules.menu": {"icon":"\uf0c9","label":"Menu","aliases":["bar"],"checked":"bar_in menu","action":"@shellDir@/bin/bar-config.sh toggle menu right"},
        "settings.bar.modules.settings": {"icon":"\uf013","label":"Bar Settings Button","aliases":["bar"],"checked":"bar_in settings","action":"@shellDir@/bin/bar-config.sh toggle settings right"},
    "settings.agents": {"icon":"\uf544","label":"Agents","description":"Which coding agent the shell launches"},
      "settings.agents.launch": {"icon":"\uf544","label":"Launch Agent","description":"Open the default coding agent in a terminal","action":"hyprctl dispatch 'hl.dsp.exec_cmd(\"@shellDir@/bin/agent-launch.sh\")'"},
      "settings.agents.default": {"icon":"\uf544","label":"Default Agent","description":"Which coding agent the shell launches"},
        "settings.agents.default.pi": {"icon":"\uf544","label":"pi","when":"command -v pi >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"pi\" ]]","action":"@shellDir@/bin/agent-default.sh pi"},
        "settings.agents.default.claude": {"icon":"\uf544","label":"Claude Code","when":"command -v claude >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"claude\" ]]","action":"@shellDir@/bin/agent-default.sh claude"},
        "settings.agents.default.codex": {"icon":"\uf544","label":"Codex","when":"command -v codex >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"codex\" ]]","action":"@shellDir@/bin/agent-default.sh codex"},
        "settings.agents.default.opencode": {"icon":"\uf544","label":"opencode","when":"command -v opencode >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"opencode\" ]]","action":"@shellDir@/bin/agent-default.sh opencode"},
        "settings.agents.default.gemini": {"icon":"\uf544","label":"Gemini CLI","when":"command -v gemini >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"gemini\" ]]","action":"@shellDir@/bin/agent-default.sh gemini"},
        "settings.agents.default.copilot": {"icon":"\uf544","label":"Copilot CLI","when":"command -v copilot >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"copilot\" ]]","action":"@shellDir@/bin/agent-default.sh copilot"},
        "settings.agents.default.crush": {"icon":"\uf544","label":"crush","when":"command -v crush >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"crush\" ]]","action":"@shellDir@/bin/agent-default.sh crush"},
        "settings.agents.default.grok": {"icon":"\uf544","label":"grok","when":"command -v grok >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"grok\" ]]","action":"@shellDir@/bin/agent-default.sh grok"},
        "settings.agents.default.omp": {"icon":"\uf544","label":"omp","when":"command -v omp >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"omp\" ]]","action":"@shellDir@/bin/agent-default.sh omp"},
    "settings.edit": {"icon":"\uf044","label":"Edit Config","description":"Open config files in nvim"},
      "settings.edit.hypr": {"icon":"\uf11c","label":"Hyprland · Binds","action":"kitty -e nvim $HOME/.config/hypr/modules/binds.lua"},
      "settings.edit.decorations": {"icon":"\uf1fc","label":"Hyprland · Decorations","action":"kitty -e nvim $HOME/.config/hypr/modules/decorations.lua"},
      "settings.edit.monitors": {"icon":"\uf108","label":"Hyprland · Monitors","action":"kitty -e nvim $HOME/.config/hypr/modules/monitors.lua"},
      "settings.edit.input": {"icon":"\uf11c","label":"Hyprland · Input","action":"kitty -e nvim $HOME/.config/hypr/modules/input.lua"},
      "settings.edit.nvim": {"icon":"\uf010","label":"Neovim · keymaps.lua","action":"kitty -e nvim $HOME/.config/nvim/lua/config/keymaps.lua"},
      "settings.edit.kitty": {"icon":"\uf120","label":"Kitty · kitty.conf","action":"kitty -e nvim $HOME/.config/kitty/kitty.conf"},
      "settings.edit.fish": {"icon":"\uf120","label":"Fish · config.fish","action":"kitty -e nvim $HOME/.config/fish/config.fish"},
      "settings.edit.pi": {"icon":"\uf544","label":"Pi · keybindings.json","when":"command -v pi >/dev/null","action":"kitty -e nvim $HOME/.pi/agent/keybindings.json"},
      "settings.edit.herdr": {"icon":"\uf0c0","label":"Herdr · config.toml","when":"command -v herdr >/dev/null","action":"kitty -e nvim $HOME/.config/herdr/config.toml"},
      "settings.edit.menu": {"icon":"\uf0c9","label":"This Menu · menu.jsonc","description":"webb-shell src/menu/menu.jsonc","aliases":["menu.jsonc"],"action":"kitty -e nvim @shellDir@/src/menu/menu.jsonc"},
      "settings.edit.shell": {"icon":"\uf0c9","label":"Shell · shell.qml","action":"kitty -e nvim @shellDir@/shell.qml"},
      "settings.edit.theme": {"icon":"\uf042","label":"Theme · Colors.qml","action":"kitty -e nvim @shellDir@/src/theme/Colors.qml"},

  // Software — install catalogue plus fzf pickers for removal.
  "software": {"icon":"\uf019","label":"Software","description":"Package management"},
    "software.install": {"icon":"\uf019","label":"Install","description":"Add software via pacman"},
      "software.install.pacman": {"icon":"\uf02d","label":"Pacman","description":"Browse repo packages (fzf picker)","action":"kitty -e @shellDir@/bin/pkg-install.sh"},
      "software.install.aur": {"icon":"\uf09c","label":"AUR","description":"fzf picker (needs yay)","action":"kitty -e @shellDir@/bin/pkg-aur-install.sh"},
      "software.install.pi": {"icon":"\uf544","label":"Install Pi Agent","description":"Coding agent · pi.dev/install.sh","when":"! command -v pi >/dev/null","action":"kitty --hold -e bash -lc 'curl -fsSL https://pi.dev/install.sh | sh'"},
      "software.install.herdr": {"icon":"\uf0c0","label":"Install Herdr","description":"Agent workspace supervisor · herdr.dev/install.sh","when":"! command -v herdr >/dev/null","action":"kitty --hold -e bash -lc 'curl -fsSL https://herdr.dev/install.sh | sh'"},
