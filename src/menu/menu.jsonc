{
  // webb-shell menu definition.
  // Dotted ids define the tree: "system.lock" sits under "system".
  // Kind is inferred: "action" -> runs the command detached,
  // "open"/"toggle" -> hands off to an existing shell popup,
  // otherwise -> submenu.
  //
  // Fields:
  //   icon        Nerd Font glyph as \uXXXX escape
  //   label       Visible row title (defaults to id)
  //   description Subtitle shown in rows; also searched
  //   aliases     Extra search terms / IPC routes
  //   action      Shell command run detached on select
  //   open        Set Popups.<name>Open = true (hand-off)
  //   toggle      Flip Popups.<name>Open (or bar visibility)
  //
  // Icons are \uXXXX escapes so this file stays plain ASCII.
  // Browse glyphs with any Nerd Font cheat sheet and swap the escapes.

  // Apps — dynamic. MenuPopup.qml injects every installed app from
  // DesktopEntries (real icon, app name + genericName) as a provider row on
  // each open, so new installs appear automatically. Static rows below (web
  // apps, agent rows) coexist with the generated list.
  "apps":              {"icon":"\uf00a","label":"Apps","description":"Launch applications","aliases":["applications"],"provider":"apps"},

  // Learn — documentation links, opened in Chromium app mode.
  "learn":             {"icon":"\uf02d","label":"Learn","description":"Docs and references","aliases":["docs","documentation"]},
  "learn.hyprland":    {"icon":"\uf1de","label":"Hyprland Wiki","action":"chromium --app=https://wiki.hypr.land/"},
  "learn.arch":        {"icon":"\uf08c","label":"Arch Wiki","action":"chromium --app=https://wiki.archlinux.org/title/Main_page"},
  "learn.lazyvim":     {"icon":"\uf121","label":"LazyVim Keymaps","action":"chromium --app=https://www.lazyvim.org/keymaps"},
  "learn.bash":        {"icon":"\uf120","label":"Bash Cheatsheet","action":"chromium --app=https://devhints.io/bash"},
  "learn.pi":          {"icon":"\uf544","label":"Pi Docs","description":"pi.dev","when":"command -v pi >/dev/null","action":"chromium --app=https://pi.dev/docs"},
  "learn.pi-pkgs":     {"icon":"\uf02d","label":"Pi Packages","description":"pi.dev/packages","when":"command -v pi >/dev/null","action":"chromium --app=https://pi.dev/packages"},
  "learn.herdr":       {"icon":"\uf0c9","label":"Herdr Docs","description":"herdr.dev","when":"command -v herdr >/dev/null","action":"chromium --app=https://herdr.dev/docs/"},

  // System
  "system":            {"icon":"\uf013","label":"System","description":"Power and session"},
  "system.reload":     {"icon":"\uf2f1","label":"Reload","description":"Lock, logout, reboot, shutdown, reload"},
  "system.reload.lock":{"icon":"\uf023","label":"Lock","action":"qs -p @shellDir@ ipc call lock engage","confirm":true},
  "system.reload.logout":{"icon":"\uf08b","label":"Logout","action":"hyprctl dispatch 'hl.dsp.exit()'","confirm":true},
  "system.reload.reboot":{"icon":"\uf021","label":"Reboot","action":"systemctl reboot","confirm":true},
  "system.reload.shutdown":{"icon":"\uf011","label":"Shutdown","action":"systemctl poweroff","confirm":true},
  "system.reload.suspend":{"icon":"\uf186","label":"Suspend","description":"Sleep the machine","action":"systemctl suspend"},
  "system.reload.hyprland": {"icon":"\uf021","label":"Reload Hyprland","description":"Re-read the Hyprland config","action":"hyprctl reload"},
  "system.reload.shell":    {"icon":"\uf21d","label":"Reload Shell","description":"Restart webb-shell","action":"hyprctl dispatch 'hl.dsp.exec_cmd(\"@shellDir@/bin/restart.sh\")'"},

  // Active window controls
  "system.windows":    {"icon":"\uf2d0","label":"Windows","description":"Active window controls"},
  "system.windows.float":     {"icon":"\uf077","label":"Toggle Float","action":"hyprctl dispatch 'hl.dsp.window.float({action=\"toggle\"})'"},
  "system.windows.fullscreen": {"icon":"\uf065","label":"Toggle Fullscreen","action":"hyprctl dispatch 'hl.dsp.window.fullscreen({mode=\"fullscreen\", action=\"toggle\"})'"},
  "system.windows.close":     {"icon":"\uf00d","label":"Close Window","action":"hyprctl dispatch 'hl.dsp.window.close()'"},
  "system.windows.layout":    {"icon":"\uf0db","label":"Toggle Layout","description":"master / dwindle","action":"@shellDir@/bin/layout-toggle.sh"},
  "system.windows.gaps":      {"icon":"\uf07e","label":"Toggle Gaps","description":"hide / show window gaps","action":"@shellDir@/bin/gaps-toggle.sh"},

  "system.usb":          {"icon":"\uf287","label":"USB Drives","description":"View and eject attached USB drives"},
  "system.usb.show":     {"icon":"\uf287","label":"Show USB Drives","description":"Details, usage and safe eject for each drive","action":"qs -p @shellDir@ ipc call usb toggle"},
  "system.usb.refresh":  {"icon":"\uf021","label":"Rescan USB Drives","action":"qs -p @shellDir@ ipc call usb refresh"},

  "system.update":      {"icon":"\uf021","label":"Update","description":"System updates and restarts"},
  "system.update.sys":  {"icon":"\uf019","label":"System Update · pacman -Syu","action":"kitty --hold -e bash -lc 'sudo pacman -Syu'"},
  "system.update.audio":{"icon":"\uf001","label":"Restart Audio","description":"pipewire + wireplumber","action":"systemctl --user restart pipewire pipewire-pulse wireplumber"},
  "system.update.wifi": {"icon":"\uDB81\uDDDC","label":"Restart Wi-Fi","description":"NetworkManager + iwd","action":"systemctl restart NetworkManager iwd"},
  "system.update.bt":   {"icon":"\uf294","label":"Restart Bluetooth","description":"bluetoothd","action":"systemctl restart bluetooth"},

  "system.power":       {"icon":"\uf0e7","label":"Power Profile","description":"performance / balanced / saver"},
  "system.power.perf":  {"icon":"\uf067","label":"Performance","action":"powerprofilesctl set performance"},
  "system.power.bal":   {"icon":"\uf021","label":"Balanced","action":"powerprofilesctl set balanced"},
  "system.power.saver": {"icon":"\uf064","label":"Power Saver","action":"powerprofilesctl set power-saver"},

  "system.account":      {"icon":"\uf084","label":"Account","description":"Password and credentials"},
  "system.account.passwd": {"icon":"\uf084","label":"Change Password","description":"passwd — current Linux account","action":"kitty --hold -e passwd"},

  "system.defaults":     {"icon":"\uf2bb","label":"Default Apps","description":"Set default applications"},
  "system.defaults.web": {"icon":"\uf0ac","label":"Web Browser","description":"Choose your default browser"},
  "system.defaults.web.firefox": {"icon":"\uf269","label":"Firefox","when":"command -v firefox >/dev/null","checked":"[[ \"$(xdg-settings get default-web-browser 2>/dev/null)\" == \"firefox.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set web firefox.desktop && hyprctl reload"},
  "system.defaults.web.chromium": {"icon":"\uf1b6","label":"Chromium","when":"command -v chromium >/dev/null","checked":"[[ \"$(xdg-settings get default-web-browser 2>/dev/null)\" == \"chromium.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set web chromium.desktop && hyprctl reload"},
  "system.defaults.web.brave": {"icon":"\uf268","label":"Brave","when":"command -v brave >/dev/null","checked":"[[ \"$(xdg-settings get default-web-browser 2>/dev/null)\" == \"brave-browser.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set web brave-browser.desktop && hyprctl reload"},
  "system.defaults.web.vivaldi": {"icon":"\uf267","label":"Vivaldi","when":"command -v vivaldi >/dev/null","checked":"[[ \"$(xdg-settings get default-web-browser 2>/dev/null)\" == \"vivaldi.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set web vivaldi.desktop && hyprctl reload"},
  "system.defaults.term":  {"icon":"\uf120","label":"Terminal","description":"Choose your default terminal emulator"},
  "system.defaults.term.kitty": {"icon":"\uf120","label":"Kitty","when":"command -v kitty >/dev/null","checked":"[[ \"$(gio mime x-scheme-handler/terminal 2>/dev/null | head -2 | awk '{print $NF}' | grep -F '.desktop' | head -1)\" == \"kitty.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set term kitty.desktop && hyprctl reload"},
  "system.defaults.files": {"icon":"\uf07c","label":"File Manager","description":"Choose your default file manager"},
  "system.defaults.files.thunar": {"icon":"\uf07c","label":"Thunar","when":"command -v thunar >/dev/null","checked":"[[ \"$(gio mime inode/directory 2>/dev/null | head -2 | awk '{print $NF}' | grep -F '.desktop' | head -1)\" == \"thunar.desktop\" ]]","action":"@shellDir@/bin/xdg-default.sh set file thunar.desktop && hyprctl reload"},

  // Theme
  "system.theme":       {"icon":"\uf1fc","label":"Theme","description":"matugen color scheme and mode"},
  "system.theme.scheme": {"icon":"\uf53f","label":"Scheme & Mode","description":"Pick a matugen palette variant","open":"scheme","aliases":["colors","palette","matugen"]},

  "shell":             {"icon":"\uf0c9","label":"Shell","description":"webb-shell controls"},
  "shell.glance":      {"icon":"\uf06e","label":"Glance","open":"glance","description":"Calendar and weather panel"},
  "shell.clock":       {"icon":"\uf017","label":"OSD Clock","toggle":"clock","description":"Toggle the corner clock"},
  "shell.bar":         {"icon":"\uf412","label":"Bar","description":"Modules, order, popup placement and tray visibility"},
  "shell.bar.visibility": {"icon":"\uf412","label":"Toggle Bar","toggle":"bar","description":"Show or hide the top bar strip"},
  "shell.bar.settings": {"icon":"\uf013","label":"Bar Settings","open":"barSettings","aliases":["bar","modules","layout","anchor"],"description":"Add, remove, reorder and re-anchor bar modules in one panel"},
  "shell.bar.modules": {"icon":"\uf0c9","label":"Modules","description":"Tick to put a module in the bar, untick to take it out"},
  "shell.bar.modules.workspaces": {"icon":"\uf009","label":"Workspaces","aliases":["bar"],"checked":"bar_in workspaces","action":"@shellDir@/bin/bar-config.sh toggle workspaces left"},
  "shell.bar.modules.recording": {"icon":"\uf03d","label":"Recording","aliases":["bar"],"checked":"bar_in recording","action":"@shellDir@/bin/bar-config.sh toggle recording right"},
  "shell.bar.modules.tray": {"icon":"\uf00a","label":"System Tray","aliases":["bar","tray"],"checked":"bar_in tray","action":"@shellDir@/bin/bar-config.sh toggle tray right"},
  "shell.bar.modules.media": {"icon":"\uf001","label":"Media","aliases":["bar"],"checked":"bar_in media","action":"@shellDir@/bin/bar-config.sh toggle media center"},
  "shell.bar.modules.find": {"icon":"\uf002","label":"Search","aliases":["bar"],"checked":"bar_in find","action":"@shellDir@/bin/bar-config.sh toggle find right"},
  "shell.bar.modules.audio": {"icon":"\uf028","label":"Audio","aliases":["bar"],"checked":"bar_in audio","action":"@shellDir@/bin/bar-config.sh toggle audio right"},
  "shell.bar.modules.wifi": {"icon":"\uf1eb","label":"Wi-Fi","aliases":["bar"],"checked":"bar_in wifi","action":"@shellDir@/bin/bar-config.sh toggle wifi right"},
  "shell.bar.modules.bluetooth": {"icon":"\uf294","label":"Bluetooth","aliases":["bar"],"checked":"bar_in bluetooth","action":"@shellDir@/bin/bar-config.sh toggle bluetooth right"},
  "shell.bar.modules.system": {"icon":"\udb80\ude10","label":"System Monitor","aliases":["bar"],"checked":"bar_in system","action":"@shellDir@/bin/bar-config.sh toggle system right"},
  "shell.bar.modules.usb": {"icon":"\uf287","label":"USB Storage","aliases":["bar"],"checked":"bar_in usb","action":"@shellDir@/bin/bar-config.sh toggle usb right"},
  "shell.bar.modules.agents": {"icon":"\uf080","label":"Agent Usage","aliases":["bar"],"checked":"bar_in agents","action":"@shellDir@/bin/bar-config.sh toggle agents right"},
  "shell.bar.modules.battery": {"icon":"\uf240","label":"Battery","aliases":["bar"],"checked":"bar_in battery","action":"@shellDir@/bin/bar-config.sh toggle battery right"},
  "shell.bar.modules.clock": {"icon":"\uf017","label":"Clock","aliases":["bar"],"checked":"bar_in clock","action":"@shellDir@/bin/bar-config.sh toggle clock center"},
  "shell.bar.modules.glance": {"icon":"\uf06e","label":"Glance","aliases":["bar"],"checked":"bar_in glance","action":"@shellDir@/bin/bar-config.sh toggle glance right"},
  "shell.bar.modules.notif": {"icon":"\uf0f3","label":"Notifications","aliases":["bar"],"checked":"bar_in notif","action":"@shellDir@/bin/bar-config.sh toggle notif right"},
  "shell.bar.modules.wallpaper": {"icon":"\uf03e","label":"Wallpaper","aliases":["bar"],"checked":"bar_in wallpaper","action":"@shellDir@/bin/bar-config.sh toggle wallpaper right"},
  "shell.bar.modules.scheme": {"icon":"\uf53f","label":"Theme Scheme","aliases":["bar"],"checked":"bar_in scheme","action":"@shellDir@/bin/bar-config.sh toggle scheme right"},
  "shell.bar.modules.menu": {"icon":"\uf0c9","label":"Menu","aliases":["bar"],"checked":"bar_in menu","action":"@shellDir@/bin/bar-config.sh toggle menu right"},
  "shell.bar.modules.settings": {"icon":"\uf013","label":"Bar Settings Button","aliases":["bar"],"checked":"bar_in settings","action":"@shellDir@/bin/bar-config.sh toggle settings right"},
  "shell.history":     {"icon":"\uf120","label":"History","description":"Clipboard, command and notification history"},
  "shell.history.clip": {"icon":"\uf0ea","label":"Clipboard History","description":"Pick a past copy to paste","action":"@shellDir@/bin/clipboard.sh"},
  "shell.history.cmd":  {"icon":"\uf120","label":"Command History","description":"Pick a past terminal command","action":"@shellDir@/bin/history.sh"},
  "shell.history.notifs": {"icon":"\uf1da","label":"Notification History","description":"Replay the last notifications as toasts","action":"qs -p @shellDir@ ipc call notify history"},
  "shell.notifs":      {"icon":"\uf0f3","label":"Notification Center","open":"notif","description":"Persistent history — read and dismiss entries one at a time","aliases":["notifications","notif history","inbox"]},
  "shell.find":        {"icon":"\uf002","label":"Find Files","open":"find","description":"Search files, folders and paths (fd)","aliases":["search","files"]},
  "shell.media":       {"icon":"\uf001","label":"Media Player","description":"Art, transport, seek and player selection — lives in the Audio panel","action":"qs -p @shellDir@ ipc call audio toggle"},
  "shell.agents":      {"icon":"\uf544","label":"Agents","description":"Coding agents and local usage"},
  "shell.agents.usage":{"icon":"\uf080","label":"Agent Usage","description":"Spend and tokens from the local session logs","action":"qs -p @shellDir@ ipc call usage toggle"},
  "shell.agents.launch":{"icon":"\uf544","label":"Launch Agent","description":"Open the default coding agent in a terminal","action":"hyprctl dispatch 'hl.dsp.exec_cmd(\"@shellDir@/bin/agent-launch.sh\")'"},
  "shell.agents.default":{"icon":"\uf544","label":"Default Agent","description":"Which coding agent the shell launches"},
  "shell.agents.default.pi":{"icon":"\uf544","label":"pi","when":"command -v pi >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"pi\" ]]","action":"@shellDir@/bin/agent-default.sh pi"},
  "shell.agents.default.claude":{"icon":"\uf544","label":"Claude Code","when":"command -v claude >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"claude\" ]]","action":"@shellDir@/bin/agent-default.sh claude"},
  "shell.agents.default.codex":{"icon":"\uf544","label":"Codex","when":"command -v codex >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"codex\" ]]","action":"@shellDir@/bin/agent-default.sh codex"},
  "shell.agents.default.opencode":{"icon":"\uf544","label":"opencode","when":"command -v opencode >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"opencode\" ]]","action":"@shellDir@/bin/agent-default.sh opencode"},
  "shell.agents.default.gemini":{"icon":"\uf544","label":"Gemini CLI","when":"command -v gemini >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"gemini\" ]]","action":"@shellDir@/bin/agent-default.sh gemini"},
  "shell.agents.default.copilot":{"icon":"\uf544","label":"Copilot CLI","when":"command -v copilot >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"copilot\" ]]","action":"@shellDir@/bin/agent-default.sh copilot"},
  "shell.agents.default.crush":{"icon":"\uf544","label":"crush","when":"command -v crush >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"crush\" ]]","action":"@shellDir@/bin/agent-default.sh crush"},
  "shell.agents.default.grok":{"icon":"\uf544","label":"grok","when":"command -v grok >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"grok\" ]]","action":"@shellDir@/bin/agent-default.sh grok"},
  "shell.agents.default.omp":{"icon":"\uf544","label":"omp","when":"command -v omp >/dev/null","checked":"[[ \"$(jq -r .defaultAgent \"$HOME/.config/webb-shell/config.json\" 2>/dev/null)\" == \"omp\" ]]","action":"@shellDir@/bin/agent-default.sh omp"},
  "shell.agents.crash":{"icon":"\uf188","label":"Diagnose Last Crash","description":"Hand the most recent coredump to the agent","action":"hyprctl dispatch 'hl.dsp.exec_cmd(\"@shellDir@/bin/crash-diagnose.sh\")'"},
  "shell.dnd":         {"icon":"\uf0f3","label":"Do Not Disturb","description":"Silence toasts into notification history","checked":"[[ \"$(jq -r '.dnd // false' \"$HOME/.local/state/webb-shell/notifications.json\" 2>/dev/null)\" == \"true\" ]]","action":"qs -p @shellDir@ ipc call notify toggle"},
  "shell.idle":        {"icon":"\uf186","label":"Idle","description":"Dim, then turn the display off and lock","aliases":["idle","sleep","dim","blank","away"]},
  "shell.idle.stayawake":{"icon":"\uf185","label":"Stay Awake","description":"Hold off the dim, display-off and idle lock","checked":"[[ \"$(jq -r '.stayAwake // false' \"$HOME/.local/state/webb-shell/idle.json\" 2>/dev/null)\" == \"true\" ]]","action":"qs -p @shellDir@ ipc call idle toggle"},
  "shell.idle.locknow":{"icon":"\uf023","label":"Lock Now","description":"Lock the screen immediately","action":"qs -p @shellDir@ ipc call lock engage"},
  "shell.reminders":   {"icon":"\uf017","label":"Reminders","description":"Set, list and clear desktop reminders"},
  "shell.reminders.set":  {"icon":"\uf017","label":"Set Reminder","description":"Remind me in N minutes","open":"reminder"},
  "shell.reminders.show": {"icon":"\uf06e","label":"Show Reminders","description":"List active reminders","action":"qs -p @shellDir@ ipc call reminder list"},
  "shell.reminders.clear":{"icon":"\uf00d","label":"Clear Reminders","description":"Forget all active reminders","action":"qs -p @shellDir@ ipc call reminder clear"},
  "shell.solidwall":   {"icon":"\uf0c8","label":"Solid Color Wallpaper","description":"No wallpaper \u2014 themed flat color","checked":"[[ ! -s \"$HOME/.local/state/webb-shell/background\" ]]","action":"printf '' > \"$HOME/.local/state/webb-shell/background\""},

  // ── Keybinds ── Catalog of useful shortcuts by tool. Selecting a row
  // copies the key combination to the clipboard; opening config files
  // belongs in Edit Config, so each category is a pure key reference.
  "binds":              {"icon":"\uf11c","label":"Keybinds","description":"Shortcuts by tool","aliases":["keys","shortcuts"]},

  "binds.hyprland":     {"icon":"\uf11c","label":"Hyprland"},
  "binds.hyprland.term":   {"icon":"\uf120","label":"SUPER + Space · Launch terminal","action":"printf '%s' 'SUPER + Space' | wl-copy"},
  "binds.hyprland.browser":{"icon":"\uf35f","label":"SUPER + B · Open Chromium","action":"printf '%s' 'SUPER + B' | wl-copy"},
  "binds.hyprland.files":  {"icon":"\uf07c","label":"SUPER + T · File manager","action":"printf '%s' 'SUPER + T' | wl-copy"},
  "binds.hyprland.float":  {"icon":"\uf2d2","label":"SUPER + F · Toggle floating","action":"printf '%s' 'SUPER + F' | wl-copy"},
  "binds.hyprland.fs":     {"icon":"\uf065","label":"SUPER + SHIFT + F · Toggle fullscreen","action":"printf '%s' 'SUPER + SHIFT + F' | wl-copy"},
  "binds.hyprland.close":  {"icon":"\uf00d","label":"SUPER + Esc · Close window","action":"printf '%s' 'SUPER + Esc' | wl-copy"},
  "binds.hyprland.focus":  {"icon":"\uf0b2","label":"SUPER + arrows · Move focus","action":"printf '%s' 'SUPER + arrow keys' | wl-copy"},
  "binds.hyprland.resize": {"icon":"\uf0de","label":"SUPER + SHIFT + arrows · Resize window","action":"printf '%s' 'SUPER + SHIFT + arrows' | wl-copy"},
  "binds.hyprland.cyclenext": {"icon":"\uf0b2","label":"SUPER + J · Focus next in stack","action":"printf '%s' 'SUPER + J' | wl-copy"},
  "binds.hyprland.focusmaster":{"icon":"\uf0b2","label":"SUPER + P · Focus master window","action":"printf '%s' 'SUPER + P' | wl-copy"},
  "binds.hyprland.promote":{"icon":"\uf067","label":"SUPER + Enter · Promote to master","action":"printf '%s' 'SUPER + Enter' | wl-copy"},
  "binds.hyprland.wsscroll":{"icon":"\uf0ec","label":"SUPER + wheel · Cycle workspaces","action":"printf '%s' 'SUPER + mouse wheel' | wl-copy"},
  "binds.hyprland.drag":{"icon":"\uf245","label":"SUPER + LMB · Drag floating window","action":"printf '%s' 'SUPER + left click' | wl-copy"},
  "binds.hyprland.resizemouse":{"icon":"\uf245","label":"SUPER + RMB · Resize window","action":"printf '%s' 'SUPER + right click' | wl-copy"},
  "binds.hyprland.nvim":{"icon":"\uf010","label":"SUPER + N · Launch Neovim","action":"printf '%s' 'SUPER + N' | wl-copy"},
  "binds.hyprland.efind":{"icon":"\uf002","label":"SUPER + E · Neovim find files","action":"printf '%s' 'SUPER + E' | wl-copy"},
  "binds.hyprland.micmute":{"icon":"\uf131","label":"XF86AudioMicMute · Mute microphone","action":"printf '%s' 'XF86AudioMicMute' | wl-copy"},
  "binds.hyprland.scratch":{"icon":"\uf2d0","label":"SUPER + SHIFT + S · Move window to scratchpad","action":"printf '%s' 'SUPER + SHIFT + S' | wl-copy"},
  "binds.hyprland.ws":     {"icon":"\uf268","label":"SUPER + [1-0] · Switch workspace","action":"printf '%s' 'SUPER + [1-0]' | wl-copy"},
  "binds.hyprland.mvws":   {"icon":"\uf21d","label":"SUPER + SHIFT + [1-0] · Move window to workspace","action":"printf '%s' 'SUPER + SHIFT + [1-0]' | wl-copy"},
  "binds.hyprland.shot":   {"icon":"\uf030","label":"Print · Fullscreen screenshot","action":"printf '%s' 'Print' | wl-copy"},
  "binds.hyprland.btop":   {"icon":"\uf17c","label":"SUPER + L · Workspace 4 + btop","action":"printf '%s' 'SUPER + L' | wl-copy"},
  "binds.hyprland.vol":    {"icon":"\uf028","label":"XF86Audio* · Volume / media keys","action":"printf '%s' 'XF86Audio* volume/media' | wl-copy"},
  "binds.hyprland.bright": {"icon":"\uf185","label":"XF86MonBrightness · Screen ±5%","action":"printf '%s' 'XF86MonBrightnessUp/Down' | wl-copy"},
  "binds.hyprland.region": {"icon":"\uf047","label":"Shift + Print · Region screenshot","action":"printf '%s' 'Shift + Print' | wl-copy"},
  "binds.hyprland.logout": {"icon":"\uf08b","label":"SUPER + SHIFT + E · Logout / shutdown","action":"printf '%s' 'SUPER + SHIFT + E' | wl-copy"},

  "binds.webb":        {"icon":"\uf0c9","label":"Webb Shell"},
  "binds.webb.bar":    {"icon":"\uf412","label":"SUPER + ; · Toggle bar","action":"printf '%s' 'SUPER + ;' | wl-copy"},
  "binds.webb.barsettings": {"icon":"\uf013","label":"SUPER + SHIFT + B · Bar settings","action":"printf '%s' 'SUPER + SHIFT + B' | wl-copy","description":"Add, remove, reorder and re-anchor bar modules"},
  "binds.webb.paper":  {"icon":"\uf03e","label":"SUPER + W · Cycle wallpaper","action":"printf '%s' 'SUPER + W' | wl-copy"},
  "binds.webb.scheme": {"icon":"\uf53f","label":"ALT + W · Theme scheme picker","action":"qs -p @shellDir@ ipc call scheme toggle","description":"matugen scheme + dark/light/smart mode"},
  "binds.webb.find":   {"icon":"\uf002","label":"ALT + SPACE · File search (fd)","action":"printf '%s' 'ALT + SPACE' | wl-copy"},
  "binds.webb.clock":  {"icon":"\uf017","label":"SUPER + C · OSD clock","action":"printf '%s' 'SUPER + C' | wl-copy"},
  "binds.webb.glance": {"icon":"\uf06e","label":"SUPER + G · Glance panel","action":"printf '%s' 'SUPER + G' | wl-copy"},
  "binds.webb.open":   {"icon":"\uf0c9","label":"SUPER + D · Open this menu","action":"printf '%s' 'SUPER + D' | wl-copy"},
  "binds.webb.monitor": {"icon":"\udb80\ude10","label":"SUPER + F2 · System monitor","action":"qs -p @shellDir@ ipc call system toggle","description":"CPU/GPU mem/disk temps + fans"},
  "binds.webb.battery": {"icon":"\uf240","label":"SUPER + H · Battery OSD","action":"printf '%s' 'SUPER + H' | wl-copy"},
