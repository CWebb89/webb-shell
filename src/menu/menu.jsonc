  // Apps — installed applications + web apps, flat list with real SVG/PNG
  // icons. iconUrl is an absolute file: path; the row renders an Image when
  // set and falls back to the icon glyph otherwise.
  "apps.pi":           {"icon":"","iconUrl":"file://@shellDir@/assets/apps/pi.svg","label":"Pi","description":"Coding agent (new session)","when":"command -v pi >/dev/null","action":"kitty -e bash -lc 'cd $HOME && pi'"},
  "apps.herdr":        {"icon":"","iconUrl":"file://@shellDir@/assets/apps/herdr.svg","label":"Herdr","description":"Agent workspace supervisor","when":"command -v herdr >/dev/null","action":"kitty -e herdr"},

  // Web apps — flat in Apps, real brand SVGs from assets/apps.
  "apps.claude":        {"icon":"","iconUrl":"file://@shellDir@/assets/apps/claude.svg","label":"Claude","description":"claude.ai","action":"chromium --app=https://claude.ai"},
  "apps.chatgpt":       {"icon":"","iconUrl":"file://@shellDir@/assets/apps/chatgpt.svg","label":"ChatGPT","description":"chatgpt.com","action":"chromium --app=https://chatgpt.com"},
  "apps.youtube":       {"icon":"","iconUrl":"file://@shellDir@/assets/apps/youtube.svg","label":"YouTube","description":"youtube.com","action":"chromium --app=https://youtube.com"},
  "apps.instagram":     {"icon":"","iconUrl":"file://@shellDir@/assets/apps/instagram.svg","label":"Instagram","description":"instagram.com","action":"chromium --app=https://instagram.com"},
  "apps.facebook":      {"icon":"","iconUrl":"file://@shellDir@/assets/apps/facebook.svg","label":"Facebook","description":"facebook.com","action":"chromium --app=https://facebook.com"},
  "apps.github":        {"icon":"","iconUrl":"file://@shellDir@/assets/apps/github.svg","label":"GitHub","description":"github.com","action":"chromium --app=https://github.com"},
