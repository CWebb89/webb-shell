  // Dev environments: rows dim when the tool is mise-managed OR pacman-
  // installed, so we never offer to shadow an existing toolchain. Uninstall
  // only removes the pacman package (mise-managed ones stay out of that list).
  "system.software.install.dev": {"icon":"\uf121","label":"Development"},
  "system.software.install.dev.go":     {"icon":"\uf121","label":"Go","disabled":"[[ -d $HOME/.local/share/mise/installs/go ]] || pkg_has go","checked":"[[ -d $HOME/.local/share/mise/installs/go ]] || pkg_has go","action":"kitty --hold -e sudo pacman -S --needed go"},
