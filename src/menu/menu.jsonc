  // Wi-Fi / Bluetooth / Audio — real popups (scotia-style panels)
  "services":           {"icon":"\uf085","label":"Services","description":"Wi-Fi, Bluetooth, Audio"},
  "services.wifi":              {"icon":"\uDB81\uDDDC","label":"Wi-Fi","description":"networks, status, power","open":"wifi","aliases":["wifi"]},
  "services.bluetooth":         {"icon":"\uf294","label":"Bluetooth","description":"devices, scan, radio","open":"bt","aliases":["bluetooth"]},
  "services.audio":             {"icon":"\uf001","label":"Audio","description":"volume, devices, streams","open":"audio","aliases":["audio"]},

  // DNS — a radio over the active connection's resolver. Each `checked` guard
  // resolves the active connection itself; the four share one batched bash
  // process and measure at ~130 ms for the whole set.
  "services.dns":              {"icon":"\uf233","label":"DNS","description":"Resolver for the active connection","aliases":["resolver","nameserver"]},
  "services.dns.auto":         {"icon":"\uf021","label":"Automatic","description":"Use the DHCP-provided resolver","checked":"c=$(nmcli -t -f NAME,DEVICE,TYPE connection show --active 2>/dev/null | awk -F: '$3==\"802-11-wireless\"||$3==\"802-3-ethernet\"{print $1;exit}'); [ -n \"$c\" ] && [ \"$(nmcli -g ipv4.ignore-auto-dns connection show \"$c\" 2>/dev/null)\" = no ]","action":"@shellDir@/bin/dns-set.sh auto"},
  "services.dns.cloudflare":   {"icon":"\uf233","label":"Cloudflare","description":"1.1.1.1 · 1.0.0.1","checked":"c=$(nmcli -t -f NAME,DEVICE,TYPE connection show --active 2>/dev/null | awk -F: '$3==\"802-11-wireless\"||$3==\"802-3-ethernet\"{print $1;exit}'); [ -n \"$c\" ] && nmcli -g ipv4.dns connection show \"$c\" 2>/dev/null | grep -q 1\\.1\\.1\\.1","action":"@shellDir@/bin/dns-set.sh cloudflare"},
  "services.dns.google":       {"icon":"\uf233","label":"Google","description":"8.8.8.8 · 8.8.4.4","checked":"c=$(nmcli -t -f NAME,DEVICE,TYPE connection show --active 2>/dev/null | awk -F: '$3==\"802-11-wireless\"||$3==\"802-3-ethernet\"{print $1;exit}'); [ -n \"$c\" ] && nmcli -g ipv4.dns connection show \"$c\" 2>/dev/null | grep -q 8\\.8\\.8\\.8","action":"@shellDir@/bin/dns-set.sh google"},
  "services.dns.quad9":        {"icon":"\uf233","label":"Quad9","description":"9.9.9.9 · 149.112.112.112","checked":"c=$(nmcli -t -f NAME,DEVICE,TYPE connection show --active 2>/dev/null | awk -F: '$3==\"802-11-wireless\"||$3==\"802-3-ethernet\"{print $1;exit}'); [ -n \"$c\" ] && nmcli -g ipv4.dns connection show \"$c\" 2>/dev/null | grep -q 9\\.9\\.9\\.9","action":"@shellDir@/bin/dns-set.sh quad9"},

  // Network helpers. Detached with setsid: MenuPopup runs actions through one
  // shared Process, so a long action would block the next menu selection.
  "services.speedtest":        {"icon":"\uf0e4","label":"Speed Test","description":"Download throughput via Cloudflare","action":"setsid @shellDir@/bin/speedtest.sh >/dev/null 2>&1 &"},
  "services.share":            {"icon":"\uf1e0","label":"Share Files","description":"Send and receive with LocalSend","when":"command -v localsend >/dev/null","action":"setsid localsend >/dev/null 2>&1 &"},


  // Capture (shell IPC -> bin/screenshot.sh)
  "capture":           {"icon":"\uf030","label":"Capture","description":"Screenshots"},
  "capture.screen":    {"icon":"\uf030","label":"Screenshot","action":"qs -p @shellDir@ ipc call screenshot full","description":"Fullscreen capture"},
  "capture.region":    {"icon":"\uf047","label":"Region","action":"qs -p @shellDir@ ipc call screenshot region","description":"Pick an area with the mouse"},
  "capture.window":    {"icon":"\uf2d0","label":"Window","action":"qs -p @shellDir@ ipc call screenshot window","description":"Active window"},
  "capture.copy":      {"icon":"\uf0c5","label":"Copy Last","action":"f=$(ls -t $HOME/Pictures/screenshots/*.png 2>/dev/null | head -1); [ -n \"$f\" ] && wl-copy --type image/png < \"$f\"","description":"Copy most recent screenshot to clipboard"},
  "capture.color":     {"icon":"\uf1fb","label":"Pick Colour","description":"Copy a hex value from the screen (needs hyprpicker)","when":"command -v hyprpicker >/dev/null","action":"setsid @shellDir@/bin/pick-color.sh >/dev/null 2>&1 &"},

  // Screen recording (bin/screenrecord.sh; needs gpu-screen-recorder)
  "capture.record":       {"icon":"\uf111","label":"Screenrecord","description":"gpu-screen-recorder"},
  "capture.record.start": {"icon":"\uf03d","label":"Start · with audio","action":"@shellDir@/bin/screenrecord.sh start"},
  "capture.record.video": {"icon":"\uf03d","label":"Start · video only","action":"@shellDir@/bin/screenrecord.sh start video"},
  "capture.record.stop":  {"icon":"\uf04d","label":"Stop Recording","when":"pgrep -f 'gpu[-]screen-recorder|wf[-]recorder' >/dev/null","action":"@shellDir@/bin/screenrecord.sh stop"},
  "capture.record.compress": {"icon":"\uf066","label":"Compress Newest","description":"Newest recording → streamable MP4 with ffmpeg","action":"setsid @shellDir@/bin/transcode.sh >/dev/null 2>&1 &"},

  // OCR + QR capture (need tesseract / zbar)
  "capture.ocr":          {"icon":"\uf15c","label":"OCR Text","description":"region → clipboard (needs tesseract)","action":"@shellDir@/bin/ocr.sh"},
  "capture.qr":           {"icon":"\uf029","label":"QR Decode","description":"region → clipboard (needs zbar)","action":"@shellDir@/bin/qr-capture.sh"},

  // Edit config files — single home for opening any config in nvim.
  "edit":              {"icon":"\uf044","label":"Edit Config","description":"Open config files in nvim"},
  "edit.hypr":         {"icon":"\uf11c","label":"Hyprland · Binds","action":"kitty -e nvim $HOME/.config/hypr/modules/binds.lua"},
  "edit.decorations":  {"icon":"\uf1fc","label":"Hyprland · Decorations","action":"kitty -e nvim $HOME/.config/hypr/modules/decorations.lua"},
  "edit.monitors":     {"icon":"\uf108","label":"Hyprland · Monitors","action":"kitty -e nvim $HOME/.config/hypr/modules/monitors.lua"},
  "edit.input":        {"icon":"\uf11c","label":"Hyprland · Input","action":"kitty -e nvim $HOME/.config/hypr/modules/input.lua"},
  "edit.nvim":         {"icon":"\uf010","label":"Neovim · keymaps.lua","action":"kitty -e nvim $HOME/.config/nvim/lua/config/keymaps.lua"},
  "edit.kitty":        {"icon":"\uf120","label":"Kitty · kitty.conf","action":"kitty -e nvim $HOME/.config/kitty/kitty.conf"},
  "edit.fish":         {"icon":"\uf120","label":"Fish · config.fish","action":"kitty -e nvim $HOME/.config/fish/config.fish"},
  "edit.pi":           {"icon":"\uf544","label":"Pi · keybindings.json","when":"command -v pi >/dev/null","action":"kitty -e nvim $HOME/.pi/agent/keybindings.json"},
  "edit.herdr":        {"icon":"\uf0c0","label":"Herdr · config.toml","when":"command -v herdr >/dev/null","action":"kitty -e nvim $HOME/.config/herdr/config.toml"},
  "edit.menu":         {"icon":"\uf0c9","label":"This Menu · menu.jsonc","description":"webb-shell src/menu/menu.jsonc","aliases":["menu.jsonc"],"action":"kitty -e nvim @shellDir@/src/menu/menu.jsonc"},
  "edit.shell":        {"icon":"\uf0c9","label":"Shell · shell.qml","action":"kitty -e nvim @shellDir@/shell.qml"},
  "edit.theme":        {"icon":"\uf042","label":"Theme · Colors.qml","action":"kitty -e nvim @shellDir@/src/theme/Colors.qml"},

  // Software management — nested under System. Curated catalog of
  // packages verified against the official repos (no AUR helper installed).
  // Install rows dim + take a ✓ once installed (disabled/checked share one
  // guard expr → single batch eval); Uninstall rows hide unless installed
  // (when guard) and mirror Install 1:1. Guards use pkg_has, the cached
  // pacman -Qq prelude in MenuModel.guardPrelude, so the bigger catalog stays
  // as fast as the old per-row `pacman -Q` checks.
  "system.software":        {"icon":"\uf019","label":"Software","description":"Package management"},
  "system.software.install":   {"icon":"\uf019","label":"Install","description":"Add software via pacman"},
  "system.software.install.pacman": {"icon":"\uf02d","label":"Pacman","description":"Browse repo packages (fzf picker)","action":"kitty -e @shellDir@/bin/pkg-install.sh"},
  "system.software.install.aur":    {"icon":"\uf09c","label":"AUR","description":"fzf picker (needs yay)","action":"kitty -e @shellDir@/bin/pkg-aur-install.sh"},
  "system.software.install.pi":     {"icon":"\uf544","label":"Install Pi Agent","description":"Coding agent · pi.dev/install.sh","when":"! command -v pi >/dev/null","action":"kitty --hold -e bash -lc 'curl -fsSL https://pi.dev/install.sh | sh'"},
  "system.software.install.herdr":  {"icon":"\uf0c0","label":"Install Herdr","description":"Agent workspace supervisor · herdr.dev/install.sh","when":"! command -v herdr >/dev/null","action":"kitty --hold -e bash -lc 'curl -fsSL https://herdr.dev/install.sh | sh'"},
  "system.software.install.webapp":   {"icon":"\uf108","label":"Web App","description":"Standalone site in its own window (chromium)","action":"kitty -e @shellDir@/bin/webapp-install.sh"},

  "system.software.install.browsers": {"icon":"\uf0ac","label":"Browsers"},
  "system.software.install.browsers.chromium": {"icon":"\uf35f","label":"Chromium","disabled":"pkg_has chromium","checked":"pkg_has chromium","action":"kitty --hold -e sudo pacman -S --needed chromium"},
  "system.software.install.browsers.firefox":  {"icon":"\uf269","label":"Firefox","disabled":"pkg_has firefox","checked":"pkg_has firefox","action":"kitty --hold -e sudo pacman -S --needed firefox"},

